# Salin ke .env.local (lokal) atau isi di Vercel → Project Settings → Environment Variables.
# Hanya placeholder. Jangan commit nilai asli.

# Koneksi Postgres. Di Vercel + Neon gunakan connection string *pooled* (host berisi "-pooler") dengan sslmode=require.
# POSTGRES_URL juga dibaca bila DATABASE_URL kosong (nama variabel bawaan integrasi Vercel/Neon).
DATABASE_URL=postgres://ripple:ripple@localhost:54329/ripple
# Database terpisah untuk tes integrasi (akan di-reset oleh suite).
DATABASE_URL_TEST=postgres://ripple:ripple@localhost:54329/ripple_test

# Minimal 32 karakter acak. Contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Parser kabar: "rule" (default), "anthropic", atau "openai-compatible".
AI_PROVIDER=rule
AI_MODEL=claude-opus-5-5
# Wajib hanya bila AI_PROVIDER=anthropic. Server-side saja.
ANTHROPIC_API_KEY=
# Wajib bila AI_PROVIDER=openai-compatible. Semua server-side, tanpa prefix NEXT_PUBLIC_.
# Contoh lokal: AI_MODEL=cx/gpt-6.1-sol dan AI_PROVIDER=openai-compatible.
OPENAI_BASE_URL=http://localhost:20129/v1
OPENAI_API_KEY=

# Origin yang diizinkan untuk mutation (CSRF). Kosong = sama dengan host request.
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
# Jam simulasi fixture (UTC). 11:40Z = 18:40 WIB. Kosongkan untuk jam nyata.
DEMO_CLOCK_ISO=2026-10-09T11:40:00Z
LOG_LEVEL=info
# Maksimum koneksi pool per instance (serverless: 1–3).
DB_POOL_MAX=3

# Telegram opsional; nonaktif sampai bot dan webhook siap. Semua server-side.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# 24-256 karakter (huruf, angka, _ atau -); token webhook berbeda dari token bot.
TELEGRAM_WEBHOOK_SECRET=
# Username bot tanpa @, misalnya lancara_demo_bot.
TELEGRAM_BOT_USERNAME=

# AI Agent LANCARA: semua perubahan aktif menunggu konfirmasi koordinator di website.
AGENT_AUTONOMY=confirm
# Budget server untuk agent produksi; kemampuan nyata tetap mengikuti model/gateway.
# Reasoning analisis (pertanyaan ringan tetap low); context berisi rundown + riwayat + hasil tool.
AGENT_REASONING_EFFORT=max
AGENT_CONTEXT_TOKENS=400000
AGENT_MAX_OUTPUT_TOKENS=128000
