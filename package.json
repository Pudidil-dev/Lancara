{
  "name": "ripple-app",
  "version": "0.1.0",
  "private": true,
  "description": "Ripple — Live Event Recovery Engine (prototipe demo hackathon)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset",
    "db:local": "node scripts/pg-local.mjs",
    "bench": "tsx scripts/bench-engine.ts",
    "eval:parser": "tsx scripts/eval-parser.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "next": "15.5.27",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.18.8",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
